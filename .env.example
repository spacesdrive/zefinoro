# =============================================================================
# Zefinoro - environment template
#
# Copy to frontend/.env and backend/.dev.vars, then fill in.
# Never commit a filled-in copy of this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (frontend/.env)
#
# Only VITE_* variables reach the browser bundle. Both are safe to expose: the
# Supabase anon key grants no access on its own, because every table is guarded
# by Row Level Security.
#
# Note there is no Cloudinary variable here. The browser receives a signed,
# short-lived upload policy from the API for each file, so no storage
# credential is ever bundled.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional. Defaults to /api, which is correct when the Worker serves the SPA.
# VITE_API_BASE_URL=/api


# -----------------------------------------------------------------------------
# Backend (backend/.dev.vars for local dev; `wrangler secret bulk` in production)
#
# These are NOT prefixed with VITE_ and never enter the browser bundle.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=

# Upstash Redis, used as a cache only - Postgres remains the source of truth.
# Take these from the Upstash console's "REST API" tab (NOT the rediss:// URL,
# which speaks the Redis wire protocol and cannot be used from a Worker).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudinary. All three are required: uploads are signed per request, and
# deleting a removed attachment needs the same credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set to "true" only when Strict Transformations is DISABLED on the cloud.
# With it enabled, Cloudinary 401s any transformed URL - including thumbnails
# and fl_attachment downloads - and the app must serve plain delivery URLs.
CLOUDINARY_ENABLE_TRANSFORMS=true


# -----------------------------------------------------------------------------
# Deployment (never committed; used by the CLI only)
# -----------------------------------------------------------------------------
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
